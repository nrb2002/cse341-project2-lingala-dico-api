        "description": "",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "schema": {
              "type": "object",
              "properties": {
                "sourceWord": {
                  "example": "any"
                },
                "targetWord": {
                  "example": "any"
                },
                "synonyms": {
                  "example": "any"
                },
                "partOfSpeech": {
                  "example": "any"
                },
                "example": {
                  "example": "any"
                },
                "pronunciation": {
                  "example": "any"
                }
              }
            }
          }
        ],
        "responses": {
