{
  "swagger": "2.0",
  "info": {
    "title": "Lingala Dico API",
    "version": "1.0.0",
    "description": "This is a bilingual dictionary API. It provides words translations from English to Lingala and vice versa, and examples of common usage."
  },
  "host": "localhost:3000",
  "basePath": "/",
  "schemes": [
    "http"
  ],
  "securityDefinitions": {
    "roleAuth": {
      "type": "apiKey",
      "in": "header",
      "name": "x-role",
      "description": "Role-based access: admin or moderator"
    }
  },
  "paths": {
    "/": {
      "get": {
        "description": "",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/v1/words/{sourceWord}": {
      "get": {
        "tags": [
          "Public Users' Endpoint"
        ],
        "summary": "Get a word's translation",
        "description": "Retrieve a validated English–Lingala dictionary entry.",
        "parameters": [
          {
            "name": "sourceWord",
            "in": "path",
            "required": true,
            "type": "string",
            "example": "love"
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/v1/words/": {
      "post": {
        "tags": [
          "Contributors' Endpoint"
        ],
        "summary": "Submit a new word",
        "description": "Submit a new dictionary entry for moderation.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "description": "New word submission",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "sourceWord": {
                  "type": "string",
                  "example": "love"
                },
                "targetWord": {
                  "type": "string",
                  "example": "bolingo"
                },
                "synonyms": {
                  "type": "array",
                  "example": [
                    "amour",
                    "liking"
                  ],
                  "items": {
                    "type": "string"
                  }
                },
                "partOfSpeech": {
                  "type": "string",
                  "example": "noun"
                },
                "example": {
                  "type": "string",
                  "example": "I love you"
                }
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Created"
          }
        }
      }
    },
    "/v1/words/{id}/validate": {
      "put": {
        "tags": [
          "Moderators' Endpoints"
        ],
        "summary": "Validate a word submission",
        "description": "",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "Word ID"
          },
          {
            "name": "authorization",
            "in": "header",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        },
        "security": [
          {
            "roleAuth": []
          }
        ]
      }
    },
    "/v1/words/status/{status}": {
      "get": {
        "tags": [
          "Moderators' Endpoints"
        ],
        "summary": "Filter words by status",
        "description": "",
        "parameters": [
          {
            "name": "status",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "Status filter (pending/validated)"
          },
          {
            "name": "authorization",
            "in": "header",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        },
        "security": [
          {
            "roleAuth": []
          }
        ]
      }
    },
    "/v1/words/all": {
      "get": {
        "tags": [
          "Moderators' Endpoints"
        ],
        "summary": "List all words in the dictionary",
        "description": "",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        },
        "security": [
          {
            "roleAuth": []
          }
        ]
      }
    },
    "/v1/words/{id}": {
      "delete": {
        "tags": [
          "Moderators' Endpoints"
        ],
        "summary": "Delete a word by ID",
        "description": "",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "Word ID"
          },
          {
            "name": "authorization",
            "in": "header",
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        }
      }
    }
  }
}