    "/v1/words/all": {
      "get": {
        "tags": [
          "Admins only"
        ],
        "summary": "Get all words. ",
        "description": "Retrieve all dictionary entries, no matter the status.",
        "responses": {
          "200": {
            "description": "OK"
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "security": [
          {
            "Bearer": []
          }
        ]
      }
    },
    "/v1/words/status/{status}": {
      "get": {
        "tags": [
          "Admins only"
        ],
        "description": "",
        "parameters": [
          {
            "name": "status",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "security": [
          {
            "Bearer": []
          }
        ]
      }
    },
    "/v1/words/{id}": {
      "put": {
        "tags": [
          "Admins only"
        ],
        "description": "",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "Word ID to update"
          },
          {
            "name": "body",
            "in": "body",
            "description": "Fields to update for a word",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "sourceWord": {
                  "type": "string",
                  "example": "love"
                },
                "targetWord": {
                  "type": "string",
                  "example": "bolingo"
                },
                "synonyms": {
                  "type": "array",
                  "example": [
                    "amour",
                    "liking"
                  ],
                  "items": {
                    "type": "string"
                  }
                },
                "partOfSpeech": {
                  "type": "string",
                  "example": "noun"
                },
                "example": {
                  "type": "string",
                  "example": "I love you"
                },
                "pronunciation": {
                  "type": "string",
                  "example": "bo-lin-go"
                },
                "status": {
                  "type": "string",
                  "example": "validated"
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "404": {
            "description": "Not Found"
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "security": [
          {
            "Bearer": []
          }
        ]
      },
      "delete": {
        "tags": [
          "Admins only"
        ],
        "summary": "Delete a word from the dictionary. ",
        "description": "Can only delete a word with the status of 'validated'. Please switch the Moderator role to delete a Submission. ",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "404": {
            "description": "Not Found"
          },
          "500": {
            "description": "Internal Server Error"
          }
        },
        "security": [
          {
            "Bearer": []
          }
        ]
      }
    },
    "/v1/words/{sourceWord}": {
      "get": {
        "tags": [
          "Public Users"
        ],
        "summary": "Get a word's translation. ",
        "description": "Retrieve a validated dictionary entry by its source word. Public endpoint.",
        "parameters": [
          {
            "name": "sourceWord",
            "in": "path",
            "required": true,
            "type": "string"
