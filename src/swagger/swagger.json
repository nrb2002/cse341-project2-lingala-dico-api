{
  "swagger": "2.0",
  "info": {
    "title": "English-Lingala Dictionary API Documentation",
    "version": "1.0.0",
    "description": "This is a bilingual (English-Lingala) dictionary API. It provides words translations from English to Lingala and vice versa, and examples of common usage."
  },
  "host": "localhost:3000",
  "basePath": "/",
  "schemes": [
    "http"
  ],
  "paths": {
    "/": {
      "get": {
        "tags": [
          "Home Page"
        ],
        "description": "",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/v1/words/": {
      "get": {
        "tags": [
          "API Endpoints"
        ],
        "summary": "Find all words",
        "description": "List all words from the database.",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "post": {
        "tags": [
          "API Endpoints"
        ],
        "summary": "Create New Word",
        "description": "Add a new word to the dictionary. ",
        "parameters": [
          {
            "name": "authorization",
            "in": "header",
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "description": "Enter New word",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "sourceLang": {
                  "type": "string",
                  "example": "en"
                },
                "targetLang": {
                  "type": "string",
                  "example": "ln"
                },
                "sourceWord": {
                  "type": "string",
                  "example": "love"
                },
                "targetWord": {
                  "type": "string",
                  "example": "bolingo"
                },
                "partOfSpeech": {
                  "type": "string",
                  "example": "noun"
                },
                "examples": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "source": {
                        "type": "string",
                        "example": "I love you"
                      },
                      "target": {
                        "type": "string",
                        "example": "Nalingi yo"
                      }
                    }
                  }
                }
              }
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Created"
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        }
      }
    },
    "/v1/words/{id}": {
      "get": {
        "tags": [
          "API Endpoints"
        ],
        "summary": "Get one word",
        "description": "Retrieve a single word by its ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "Word ID"
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Bad Request"
          },
          "404": {
            "description": "Not Found"
          }
        }
      },
      "put": {
        "tags": [
          "API Endpoints"
        ],
        "summary": "Edit Word",
        "description": "Edit a specific word and save it to the dictionary. ",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "authorization",
            "in": "header",
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "description": "Updated word fields",
            "required": true,
            "schema": {
              "type": "object",
              "properties": {
                "sourceLang": {
                  "type": "string",
                  "example": "en"
                },
                "targetLang": {
                  "type": "string",
                  "example": "ln"
                },
                "sourceWord": {
                  "type": "string",
                  "example": "love"
                },
                "targetWord": {
                  "type": "string",
                  "example": "bolingo"
                },
                "partOfSpeech": {
                  "type": "string",
                  "example": "noun"
                },
                "examples": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "source": {
                        "type": "string",
                        "example": "I love you"
                      },
                      "target": {
                        "type": "string",
                        "example": "Nalingi yo"
                      }
                    }
                  }
                }
              }
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          },
          "404": {
            "description": "Not Found"
          }
        }
      },
      "delete": {
        "tags": [
          "API Endpoints"
        ],
        "summary": "Delete word",
        "description": "Delete a word from the dictionary by ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string",
            "description": "Word ID"
          },
          {
            "name": "authorization",
            "in": "header",
            "type": "string"
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "400": {
            "description": "Bad Request"
          },
          "401": {
            "description": "Unauthorized"
          },
          "403": {
            "description": "Forbidden"
          }
        }
      }
    }
  }
}